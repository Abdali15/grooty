# Backend only. Never use VITE_ for these values. Leave disabled until activation.
NODE_ENV=production
ADMIN_ENABLED=false
APP_ORIGIN=https://YOUR-PRODUCTION-DOMAIN.vercel.app
DATABASE_URL=
# Optional PEM certificate if provider's CA is not in system trust. TLS remains verified.
DATABASE_CA_CERT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development: NODE_ENV=development, APP_ORIGIN=http://localhost:3000
PORT=3000

# Local migration/authorization CLI ONLY; do not set in Vercel runtime.
DATABASE_ADMIN_URL=

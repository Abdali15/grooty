# Backend only. Never use VITE_ for these values. Leave disabled until activation.
NODE_ENV=production
AUTH_GOOGLE_ENABLED=false
AUTH_MICROSOFT_ENABLED=false
ADMIN_MFA_REQUIRED=true
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=mock
PAYMENT_ENVIRONMENT=mock
PREORDERS_ENABLED=false
CUSTOM_REQUESTS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
APP_ORIGIN=https://YOUR-PRODUCTION-DOMAIN.vercel.app
DATABASE_URL=
# Optional PEM certificate if provider's CA is not in system trust. TLS remains verified.
DATABASE_CA_CERT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers
MICROSOFT_ALLOWED_TENANTS=9188040d-6c67-4c5b-b112-36a304b66dad
# Base64 32-byte AES key; only server/secret manager; rotation requires re-encrypting MFA rows.
MFA_ENCRYPTION_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
CRON_SECRET=
# >=32 characters, server-only; hashes IPs for shared limiter buckets.
RATE_LIMIT_KEY_SECRET=
# Local development: NODE_ENV=development, APP_ORIGIN=http://localhost:3000
PORT=3000

# Local migration/authorization CLI ONLY; do not set in Vercel runtime.
DATABASE_ADMIN_URL=
